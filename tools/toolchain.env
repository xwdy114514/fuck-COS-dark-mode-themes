# MCTGA 工具链基线（build.sh 启动时 source 并校验）
# 改这里的任何一项，都要同步：docs/更新总集.md 记一行 + docs/需要避开的坑.md 说明原因。

# 本机（KB2000）：chroot 里的 Alpine JDK 21，包装脚本在 /data/local/tmp/tc21/bin
# d8 已从旧的 R8 8.2.2 换成 9.4.34（旧版处理 JDK21 产物会 NPE）
JAVA_HOME_DEFAULT=/data/local/tmp/tc21

# 版本按前缀匹配（Alpine 的 javac 输出是四段 21.0.13.0.3，PJD110 是 21.0.13）
PIN_JAVA_VERSION=21.0.13

# d8 / android.jar 基线（所有构建入口校验不符即停止；本机可用 D8_JAR 指向同哈希文件）
PIN_D8_MD5=9cbe9ecdfd3bed245f681d74a650737a
PIN_AJ_MD5=3d3a962caad5b8ee4560183126b10afa
