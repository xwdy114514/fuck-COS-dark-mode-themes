# MCTGA 工具链基线（build.sh 启动时 source 并校验）
# 改这里的任何一项，都要同步：docs/更新总集.md 记一行 + docs/需要避开的坑.md 说明原因。
# 基线只有一个目的：让任何人、任何机器构建出来的 classes.dex 尽量一致，便于比对发布包。

# 默认 JDK（aarch64 自带 JDK 21，位于工具链 prefix 内）
JAVA_HOME_DEFAULT=/data/local/tmp/tc/prefix/lib/jvm/java-21-openjdk

# javac 版本基线：不一致时 build.sh 直接拒绝构建（本地试验可 ALLOW_JAVA_MISMATCH=1）
PIN_JAVA_VERSION=21.0.13

# d8 / android.jar 基线（只提示，不阻断）
PIN_D8_MD5=1b9c3a965f91d74b773b71de1d48a743
PIN_AJ_MD5=3d3a962caad5b8ee4560183126b10afa
